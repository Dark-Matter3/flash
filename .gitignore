# Environment & Secrets
.env
.env.local
.env.*.local

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
*~

# OS Files
.DS_Store
Thumbs.db
.directory
.Spotlight-V100
.Trash

# Development & Testing
node_modules/
.cache/
dist/
build/

# Backup & Temporary
*.backup
*.bak
*.tmp
*.old
.git-backup*/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# detect-secrets baseline — tracked by git with is_secret=False markings
# Do NOT add to gitignore; track it so false positives persist across team
# !.secrets.baseline  <-- not needed; .secrets.baseline not matched by any rule above

# Local scratch / dev-only exports
scratch/
exports/
tmp/
working/
PRIVATE_NOTES/

# Firebase service account (NEVER in a public repo)
*service-account*.json
firebase-service-account*.json
*-credentials.json

# Private keys
*.pem
*.key
*.p12
*.pfx
